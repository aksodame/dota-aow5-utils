# pnpm names each package's directory in the virtual store after its full
# resolution, hash and all, which routinely runs past a hundred characters.
# `makensis` is not long-path aware, and electron-builder's NSIS scripts
# `!include` their own headers *out of the store* — that path lands at 264
# characters here, four over Windows' MAX_PATH, and the installer fails to
# build. On the GitHub runner it is barely shorter, so it fails there too.
#
# Truncating the directory name to 50 characters is the fix that keeps pnpm's
# strict isolation; the alternative, `node-linker=hoisted`, buys the same
# shorter paths by giving the whole workspace a flat node_modules.
#
# Needs pnpm >= 9.1, which is why `packageManager` in package.json is not 9.0.0.
virtual-store-dir-max-length=50
