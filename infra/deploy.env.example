# Where `infra/remote-deploy.sh` deploys to.
#
# You do not have to write this file: run the script and it asks for whatever it
# needs, then saves the answers here. This is what it will have written, and a
# reference for editing it later.
#
# Not secrets — a host, a domain, an email, a path. Credentials are two other
# files, neither of them this one:
#
#   /srv/aow5/.env                the runtime secrets. The script builds it and
#                                 installs it `chmod 600` on the server, and
#                                 that is the only machine it exists on
#   infra/deploy.secrets.enc      what the *deploy* needs on every run, chiefly
#                                 the DuckDNS token. AES-256 under one
#                                 passphrase, via openssl. Read it by hand with
#                                 `openssl enc -d -aes-256-cbc -pbkdf2 -in` it
#
# Export AOW5_DEPLOY_PASSPHRASE to skip that prompt — required in CI, where
# there is nobody to type it.
#
# Every line can be overridden from the environment for a one-off, without
# editing anything:
#
#   SITE_DOMAIN=staging.example.com infra/remote-deploy.sh

# The server, as ssh reaches it. A `~/.ssh/config` alias works.
AOW5_SSH=deploy@203.0.113.10
AOW5_SSH_PORT=22

# The private key that opens it. A bare name is looked up in ~/.ssh, so
# `id_fornex` and `/Users/me/.ssh/id_fornex` mean the same thing.
#
# Blank is a real answer: it means "whatever ssh already does", which is right
# when ~/.ssh/config has a Host block for this server, or when the key is simply
# called id_ed25519. It is the wrong answer for a per-provider key under its own
# name reached by bare address — ssh will not find it, and what you get instead
# is a password prompt part-way through a deploy.
#
# Named here, the key is also passed with IdentitiesOnly, so it is the only one
# offered: an agent holding several keys can otherwise trip a server's
# MaxAuthTries before the right one is reached.
AOW5_SSH_KEY=

# `own` for a domain whose A record you manage, `duckdns` for a free name the
# script points at the server and keeps pointed there.
AOW5_DNS=own

# The name the certificate is issued for, and where expiry warnings go. This is
# the one place a domain move happens: the API's SITE_ORIGIN, Caddy's
# certificate and the sign-in return URLs are all derived from it.
SITE_DOMAIN=builds.example.com
ACME_EMAIL=you@example.com

# Only with AOW5_DNS=duckdns. The token is *not* kept here — it is a credential.
# It goes two places: the server's env file, where the refresh timer reads it,
# and `infra/deploy.secrets.enc` on this machine, because the record is
# re-pointed on every deploy and nobody should be retyping a token that often.
# DUCKDNS_SUBDOMAIN=aow5helper

# Where the code, the env file and the SQLite database live on the server.
AOW5_REMOTE_DIR=/srv/aow5

# Where the two images get built.
#
#   remote  on the server, by deploy.sh. The default, and right for a box with
#           2 GB of memory or more.
#   local   here, for linux/amd64, then streamed to the server's image store
#           with `docker save | docker load`. The server runs no build stage.
#
# The split is memory. The webapp's Vite + two-pass-terser run over ~25 MB of
# committed icons peaks near 2 GB, while the images it produces need under
# 300 MB to *run* — so a small VPS is a fine host and a poor builder. The script
# reads the server's MemTotal and defaults accordingly, and warns before letting
# you pick `remote` on a machine that cannot finish it.
#
# `local` needs Docker with buildx on this machine. On an arm64 Mac the build is
# emulated and slow the first time; the platform is pinned regardless, because
# an arm64 image reaches the server intact and fails at `docker run`.
AOW5_BUILD=remote
