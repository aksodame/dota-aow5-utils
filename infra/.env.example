# Copy to /srv/aow5/.env on the server, fill it in, and `chmod 600` it.
#
# Not in the repository and never baked into an image: docker compose reads it
# at deploy time (see infra/deploy.sh) and passes only what each service needs.

# The name the site is served from — any domain, not necessarily DuckDNS.
#
# Caddy requests a Let's Encrypt certificate for exactly this and renews it
# forever, so the name must already resolve to this machine before the first
# deploy: the ACME challenge arrives over the public name, and a wrong A record
# is a failed issuance rather than a slow one. `remote-deploy.sh` checks it
# before shipping anything, and rewrites this line to whatever it deployed.
SITE_DOMAIN=builds.example.com

# Where Let's Encrypt sends expiry warnings. Required.
ACME_EMAIL=you@example.com

# --- DuckDNS (only if the domain above is a DuckDNS one) ---------------------
#
# The subdomain (the part before .duckdns.org) and its token, used by the
# refresh timer in infra/systemd/ to keep the record pointed at this machine.
# On a real domain with a static A record neither of these is needed, and the
# timer should not be installed — nothing else reads them.
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=

# The Freesound API key the tracker's sound search is proxied through.
#
# Optional. Without it the API answers "not configured", the picker hides its
# search box, and everything else works exactly as before — so a deployment that
# does not want this feature simply leaves the line out.
#
# Get one at https://freesound.org/apiv2/apply (a free account, then "API
# credentials"; the plain token is enough — the OAuth2 client secret beside it
# is for downloading original files, which this never does). It is a credential:
# the quota is 2000 requests a day and it is shared by every tracker pointed at
# this server.
FREESOUND_TOKEN=

# The Steam Web API key, used only to read a signed-in player's display name
# and avatar.
#
# Optional, including in production. Identity comes from Steam's OpenID
# endpoint, which needs no key at all; this is used afterwards, for one call to
# GetPlayerSummaries. Without it people still sign in and still own their
# builds — they just get a persona derived from their SteamID until a key is
# set, at which point the next sign-in fills in the real one.
#
# Get one at https://steamcommunity.com/dev/apikey. It is tied to a Steam
# account and to the domain you register it against, so use the deployment's
# own domain rather than a personal one.
#
# SITE_ORIGIN above is load-bearing for sign-in: it is what the OpenID return
# URL and realm are built from, and Steam refuses a callback that does not
# match. A deployment whose SITE_ORIGIN is wrong cannot sign anybody in.
STEAM_API_KEY=

# --- Discord sign-in (optional) ----------------------------------------------
#
# Both or neither. An id without a secret is a sign-in button that always
# fails, which is worse than one that is not offered — so the API treats a
# half-filled pair as no Discord at all, and `GET /auth/providers` simply does
# not list it. Local accounts and Steam are unaffected either way.
#
# Make an application at https://discord.com/developers/applications, then under
# OAuth2 add this exact redirect:
#
#     https://<SITE_DOMAIN>/api/auth/discord/return
#
# Discord matches it literally, so the scheme, the host and the trailing path
# must all agree with SITE_ORIGIN above. No scopes need configuring there: the
# API asks for `identify` and nothing else, because a name, an avatar and a
# stable id are all this site stores — it has no use for an email address.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Social cards (optional, and normally left alone) -------------------------
#
# The API composes a 1200x630 PNG per build for link previews, out of hero art
# and item icons on disk, and caches the result. All three of these have correct
# defaults inside the container and exist for running the API outside one.
#
#   ASSETS_DIR      the extracted icon tree. `./assets` in the image, which is
#                   where infra/api.Dockerfile copies it to.
#   BRAND_DIR       the site's wordmark. `./assets-brand` in the image. Separate
#                   from the above because it is branding rather than extracted
#                   game data, and comes from the webapp rather than the shared
#                   package.
#   CARD_CACHE_DIR  rendered cards. Defaults to `og/` beside DATABASE_PATH,
#                   which puts it on the data volume — see infra/README.md. It
#                   is a cache: deleting it costs one render per card.
#
# A missing directory is not fatal. The card is drawn without whatever it could
# not read, because a preview with no portrait on it beats a 500 on a link
# somebody shared.
# ASSETS_DIR=
# BRAND_DIR=
# CARD_CACHE_DIR=
