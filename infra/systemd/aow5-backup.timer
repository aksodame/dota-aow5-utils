[Unit]
Description=Snapshot the AOW5 SQLite database nightly

[Timer]
OnCalendar=*-*-* 03:30:00
Persistent=true
# The host runs on UTC, so this is 03:30 UTC. Spread by a minute so a fleet of
# one is still not hammering the disk at exactly the same instant as anything
# else scheduled on the hour.
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
