# The whole web tier: TLS, the static site, and (from phase 1) the API proxy.
#
# One origin on purpose. The SPA and the API share a domain, so there is no CORS
# preflight to configure and the session cookie is a plain first-party cookie —
# which is what makes SameSite=Lax sufficient and a CSRF token layer redundant.

{
	# Expiry warnings and ACME account recovery. Required: Caddy fails to load
	# with an empty value, which is the right outcome — a missing contact should
	# be loud at deploy time, not discovered when a renewal breaks.
	email {$ACME_EMAIL}

	# Uncomment for a first-issuance rehearsal. Let's Encrypt allows five
	# failures per hour against production and that is easy to burn while one
	# firewall rule is still wrong; staging has no meaningful limit. The
	# certificate it hands back is untrusted by design — you are testing the
	# plumbing, not the certificate. Comment it out and restart once you have
	# watched one get issued.
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

{$SITE_DOMAIN} {
	encode zstd gzip

	# The API first. A path prefix rather than a subdomain is the whole reason
	# this is one origin: no CORS preflight to configure, and the session cookie
	# is an ordinary first-party cookie, which is what makes SameSite=Lax
	# sufficient on its own.
	handle /api/* {
		# The body cap, one hop earlier than the 32 kB one in apps/api/src/main.ts.
		# Express only learns a body is too big after reading it; Caddy closes the
		# connection without the API waking up at all, so a flood of oversized
		# posts never becomes Node's problem. Set above the app's own limit on
		# purpose — the app is what should be rejecting a merely-too-large board,
		# with a message; this is for what is not a board at all.
		request_body {
			max_size 64KB
		}
		reverse_proxy api:3000
	}

	# robots.txt and the sitemap, both generated by the API.
	#
	# Generated rather than checked in because both have to name this
	# deployment's own origin by absolute URL — a sitemap entry and a `Sitemap:`
	# line are not allowed to be relative — and a static file would either
	# hardcode a domain or omit the line that makes the sitemap discoverable at
	# all. The API is the only thing here that knows `SITE_ORIGIN`.
	#
	# The trade: a down API means a 5xx on robots.txt, which crawlers read as
	# "come back later" and back off site-wide. Accepted because the API is
	# already a hard dependency of every page that has content on it, and
	# because compose will not start this container until the API is healthy.
	handle /robots.txt {
		rewrite * /api/seo/robots.txt
		reverse_proxy api:3000
	}

	handle /sitemap.xml {
		rewrite * /api/seo/sitemap.xml
		reverse_proxy api:3000
	}

	# Link scrapers get a prerendered page. Everybody else gets the app.
	#
	# This site is a single-page app with no server rendering, so index.html
	# carries one static head for all seven routes. A browser fixes that a
	# moment after boot — see src/lib/meta.ts — but Facebook, Discord, Telegram,
	# Slack, WhatsApp, Twitter and VK do not run JavaScript at all: they fetch
	# the document, read the tags that are *in* it, and leave. Which is why every
	# shared build link previewed identically before this block existed.
	#
	# Matched on User-Agent, which is the part worth being careful about. The
	# risk in serving crawlers something different from readers is cloaking, so
	# the prerenderer renders the *same* title, facts and notes the React page
	# does — a copy, not a substitute. See apps/api/core/seo/html.ts.
	#
	# The `not path` list is what keeps a scraper's fetch of `og:image` — and of
	# every hashed asset — out of here. `/api/*` needs no exclusion: its handle
	# block is above this one and Caddy takes the first that matches.
	@crawler {
		header_regexp User-Agent "(?i)(facebookexternalhit|facebookcatalog|Facebot|Twitterbot|Discordbot|TelegramBot|Slackbot|Slack-ImgProxy|WhatsApp|LinkedInBot|Googlebot|Google-InspectionTool|Storebot-Google|bingbot|BingPreview|DuckDuckBot|YandexBot|YandexRenderResourcesBot|Applebot|redditbot|vkShare|Pinterest|Mastodon|Bluesky|SkypeUriPreview|Embedly|Iframely|OpenGraph|MetaInspector|Synapse|Matrix)"
		not path /assets/* /icons/* /data/* /builder/*
		not path *.png *.jpg *.jpeg *.gif *.svg *.ico *.webp *.js *.css *.json *.txt *.xml *.map *.webmanifest *.woff *.woff2
	}

	handle @crawler {
		# The path travels in a header rather than in a query parameter, which
		# would have to be URL-encoded here and decoded there — a round trip with
		# two places to get the escaping wrong and no way to notice. The trailing
		# `?` clears the original query so it cannot reach the endpoint twice.
		rewrite * /api/seo/prerender?
		reverse_proxy api:3000 {
			header_up X-Original-URI {http.request.orig_uri}
		}
	}

	# Clients holding the retired pages.dev redirect ask for /builder/icons/...
	#
	# aow5-builder's public/_redirects used to prefix every path on that origin
	# with /builder/, and Pages served the rule as a 301 carrying a 30-day
	# Cache-Control. Fixing it at the source therefore does not reach a client
	# that already stored the entry: it skips pages.dev altogether until the
	# entry expires. This aliases /builder/* onto the same tree as /*, so those
	# requests resolve to real files instead of falling through to the SPA
	# fallback and coming back as 200 text/html.
	#
	# `handle_path` strips the prefix but leaves the browser's URL alone, so the
	# planner's own /builder route still renders from the fallback below — and
	# bare /builder, which does not match /builder/*, is untouched entirely.
	#
	# Transitional. Delete it once the cached 301s have aged out.
	handle_path /builder/* {
		root * /srv/www
		try_files {path} /index.html
		file_server
	}

	handle {
		root * /srv/www

		# The cache policy is the table in apps/webapp/README.md under
		# "Deploying". That table has been the contract since the Cloudflare
		# days; this is the file that finally implements it.

		# Vite fingerprints these filenames, so they can never go stale.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# Icon filenames come from game data and are NOT hashed, so `immutable`
		# would pin stale art through a parser refresh. Covers items, spells and
		# portraits.
		@icons path /icons/*
		header @icons Cache-Control "public, max-age=2592000"

		# Regenerated by every extraction run.
		@data path /data/*
		header @data Cache-Control "public, max-age=3600, must-revalidate"

		# Everything else is HTML: the entry point, or a route `try_files` is
		# about to rewrite into it. Matched by exclusion because `header` runs
		# *before* `try_files` in Caddy's directive order — a matcher here sees
		# `/builder`, never the `/index.html` it is about to become. A stale
		# entry point would reference dead asset hashes.
		@html not path /assets/* /icons/* /data/*
		header @html Cache-Control "no-cache"

		# The SPA fallback: the same job as the 404.html the build still emits,
		# without the 404 status. Unlike a redirect it leaves the URL untouched,
		# which matters here because a planner link carries the entire board in
		# its fragment.
		try_files {path} /index.html
		file_server
	}

	header {
		-Server
		# One host is reached directly rather than proxied: the tracker landing
		# asks api.github.com for the latest release at runtime, which is a
		# `connect-src` exception because a static page cannot bake in a version it
		# is deployed independently of. `unsafe-inline` for styles is Tailwind 4,
		# which injects them at runtime.
		#
		# `img-src` names two hosts besides our own, and both are load-bearing:
		#
		#   * Steam's avatar CDN, as a wildcard. `avatarfull` is a URL on
		#     `avatars.steamstatic.com` through the Web API and on one of the
		#     `*.steamstatic.com` mirrors through the public profile the API
		#     falls back to when no key is configured — naming only the first
		#     would block half the avatars, in production and nowhere else,
		#     because there is no policy in front of the dev server.
		#   * Discord's avatar CDN, for accounts that signed in through Discord.
		#     The same reasoning as Steam's: the API stores whichever avatar URL
		#     the provider handed back, so every provider it accepts needs a line
		#     here or its users render with a broken image.
		#   * YouTube's thumbnail host, for a build's video panel. The panel is a
		#     still until it is clicked, so this is what it shows; `frame-src`
		#     below is what it becomes.
		#
		# `script-src 'self'` covers the sign-up proof-of-work worker, which Vite
		# emits as a real file for exactly that reason; a `blob:` worker would
		# need widening this and does not exist.
		#
		# `frame-src` is spelled out because without it a frame falls back to
		# `default-src 'self'` and the player is a silent empty box. The nocookie
		# host is the only one named: it is what both the tracker's setup video
		# and a build's video panel embed, and the player pulls everything else
		# from inside its own frame, where our policy does not reach.
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https://*.steamstatic.com https://cdn.discordapp.com https://i.ytimg.com; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://api.github.com; frame-src https://www.youtube-nocookie.com; form-action 'self'; frame-ancestors 'none'; base-uri 'none'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
	}
}
