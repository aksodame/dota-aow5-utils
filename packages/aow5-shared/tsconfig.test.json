{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "skipLibCheck": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo"
  },
  // `node --test` runs these against the committed id tables and emitted JSON,
  // so the codec and the loaders are checked a second time under Node's
  // resolution — tsconfig.src.json checks them for the browser.
  //
  // `src/seo` and `src/format` are here for a second reason on top of that one:
  // the API compiles them into its bundle, and the API is Node. Checking them
  // only under tsconfig.src.json — which is configured for the browser, down to
  // the DOM lib — would check them against the one environment neither of their
  // two consumers runs in.
  "include": ["src/**/*.test.ts", "src/types", "src/build", "src/data", "src/seo", "src/format"]
}
